{
  "name": "oudia-second-web",
  "version": "0.0.0",
  "private": true,
  "description": "OuDiaSecond を TypeScript + React でブラウザ向けに再実装するプロジェクト",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @oudia/web dev",
    "build": "pnpm -r run build",
    "typecheck": "tsc --build",
    "lint": "pnpm run lint:eslint && pnpm run lint:deps",
    "lint:eslint": "eslint .",
    "lint:deps": "depcruise packages apps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @oudia/web e2e",
    "bench": "vitest bench --run",
    "license-check": "node scripts/license-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
