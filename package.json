{
  "name": "oudia-web",
  "version": "0.0.0",
  "private": true,
  "description": "OuDiaSecond を TypeScript + React でブラウザ向けに再実装するプロジェクト",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @oudia-web/web dev",
    "build": "pnpm -r run build",
    "typecheck": "tsc --build",
    "check:code": "biome check --write && depcruise packages apps",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @oudia-web/web e2e",
    "bench": "vitest bench --run",
    "cf:preview": "pnpm --filter @oudia-web/web build && pnpm --filter @oudia-web/web cf:preview",
    "cf:deploy": "pnpm --filter @oudia-web/web build && pnpm --filter @oudia-web/web cf:deploy",
    "license-check": "node scripts/license-check.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.9.0",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.112.0"
  }
}
