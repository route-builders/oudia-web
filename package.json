{
  "name": "oudia-second-web",
  "version": "0.0.0",
  "private": true,
  "description": "OuDiaSecond を TypeScript + React でブラウザ向けに再実装するプロジェクト",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --build",
    "lint": "pnpm run lint:eslint && pnpm run lint:deps",
    "lint:eslint": "eslint .",
    "lint:deps": "depcruise packages apps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
